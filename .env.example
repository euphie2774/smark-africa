# Copy this file to .env and fill in your actual values
# NEVER commit .env to git

SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourSecurePassword123!
ADMIN_EMAIL=admin@smarkafrica.com

# M-Pesa Daraja API
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_SHORTCODE=174379
DARAJA_ENV=sandbox

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_ENV=sandbox

# Resend (email)
# Get your API key from https://resend.com/api-keys
# By default emails are sent from onboarding@resend.dev (Resend test domain)
# To use your own domain, verify it at https://resend.com/domains
# and set from_email in admin settings to your verified domain
RESEND_API_KEY=

# Africa's Talking (SMS)
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Mail (SMTP fallback)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional
REDIS_URL=
# Database
# Leave blank for local development (falls back to sqlite:///smarkafrica.db).
# Required for production/hosted deploys - SQLite there resets user accounts on redeploy.
# Format: postgresql://user:password@host:5432/dbname
# A bare postgres:// URL (Render/Heroku style) is rewritten to postgresql:// automatically.
DATABASE_URL=
# Optional pool tuning. Keep workers x (DB_POOL_SIZE + DB_MAX_OVERFLOW) under
# your provider's connection cap - see gunicorn.conf.py for the worker count.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE=280
OPENAI_API_KEY=

# --- Geo: shipping distance, routing and maps ---------------------------------
# Everything below is OPTIONAL. With all of it blank the app uses a built-in
# haversine router and a 111-entry Kenyan gazetteer, so quotes and tracking work
# out of the box. Set these to swap in real infrastructure without code changes.

# Routing / ETA. 'fallback' (default, built-in haversine) or 'valhalla'.
GEO_ROUTING_PROVIDER=
VALHALLA_URL=
VALHALLA_TIMEOUT=6
# 'auto' for vans/cars, 'motorcycle' for boda deliveries.
VALHALLA_COSTING=auto

# Address search and reverse geocoding. 'fallback' (default, built-in gazetteer) or 'pelias'.
GEO_GEOCODER=
PELIAS_URL=
PELIAS_TIMEOUT=5

# --- Driver trace map matching ---
# Snaps the GPS breadcrumbs on the dispatch and driver maps onto the roads that
# were actually driven, instead of joining fixes ~20s apart with straight lines
# that cut across blocks and buildings.
#
#   fallback (default) - no road network in-process, so the trace can only be
#                        cleaned (bad fixes dropped), not snapped. Drawn dashed.
#   valhalla           - /trace_route map matching; reuses VALHALLA_URL above.
#   osrm               - /match service; set OSRM_URL below.
#
# This is the one geo setting that changes what staff see rather than only what
# they are charged, so it is worth pointing at a real service in production.
GEO_TRACE_PROVIDER=
OSRM_URL=
OSRM_TIMEOUT=6
# 'driving' matches how most OSM extracts are built; 'bike' is closer to a boda.
OSRM_PROFILE=driving

# GPS fixes that fail these gates are dropped before matching, since feeding a
# vague or impossible fix to a matcher is how a snapped line ends up confidently
# drawn down the wrong street.
GEO_TRACE_MAX_ACCURACY_M=100
GEO_TRACE_MAX_SPEED_KPH=200
GEO_TRACE_MIN_MOVE_M=15

# Straight-line -> road distance correction and fallback ETA speed, used only
# when no routing engine is configured (or one is down).
GEO_ROAD_FACTOR=1.32
GEO_AVG_SPEED_KMH=45

# MapLibre basemap. Blank uses keyless OpenStreetMap raster tiles; point this at
# a vector style URL (MapTiler, Protomaps, your own tileserver) for production.
MAP_STYLE_URL=

# Route, geocode and matched-trace results are cached through the Flask-Caching
# instance above, which is Redis-backed whenever REDIS_URL is set.
